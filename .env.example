# ============================================================
#  「诶呀妈呀 今天吃啥呀」环境变量模板
#  用法：复制为 .env（或在小程序云开发控制台配置云函数环境变量）
#  注意：真实值请勿提交到仓库；.env 已在 .gitignore 中忽略
# ============================================================

# ---------- 云开发环境 ----------
# env1（主环境：小程序端 + 用户业务云函数）
TCB_ENV=your-env-id-1
ENV1_ENV_ID=your-env-id-1
# env2（AI 生成环境：bypass* 批量生成云函数）
TCB_ENV2=your-env-id-2
ENV2_ENV_ID=your-env-id-2

# ---------- 腾讯云 API 密钥（本地运维脚本使用，云函数内不需要）----------
# 在云开发控制台「密钥管理」获取
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_ENV2_SECRET_ID=
TCB_ENV2_SECRET_KEY=

# ---------- 管理员鉴权 ----------
# 多个管理员用英文逗号分隔
ADMIN_OPENIDS=
ADMIN_OPENID=
# 后台管理页登录口令
ADMIN_PASSWORD=

# ---------- 内部共享密钥 ----------
# 云函数之间内部调用的鉴权密钥（如 submitContribution → mergeContributions）
# 未配置时相关内部调用一律拒绝（fail-closed），请务必设置一个长随机值
MERGE_SYS_SECRET=
# Web 版游客身份哈希盐（webApi），未配置时拒绝签发游客身份
WEB_SALT=

# ---------- AI 通道 ----------
# 自定义文本/图片模型通道
CUSTOM_AI_KEY=
CUSTOM_IMAGE_KEY=
# 备用 AI 通道（如 SiliconFlow）
SF_KEY=
# 生成熔断开关：设为 'false' 可关闭批量生成（默认开启）
GEN_DISABLED=

# ---------- 虚拟支付（微信「虚拟支付」能力）----------
VP_APP_KEY=
VP_APP_SECRET=
VP_MSG_TOKEN=

# ---------- 邮件通知（可选）----------
QQ_MAIL_USER=
QQ_MAIL_PASS=

# ---------- 运维接口令牌（可选）----------
REVIEW_TOKEN=
