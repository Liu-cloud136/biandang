.page { min-height: 100vh; background: #FFF8F0; }
.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #FFF8F0;
  position: relative;
}
.nav-back {
  position: absolute;
  left: 24rpx;
  font-size: 40rpx;
  color: #333;
  display: flex;
  align-items: center;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.wrap { padding: 48rpx 40rpx; }

.steps {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  background: #FFD9C2;
  margin-right: 16rpx;
}
.dot.on { background: #FF8C42; }
.step-text { margin-left: auto; color: #999; font-size: 26rpx; }

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 40rpx;
  line-height: 1.4;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.chip {
  padding: 20rpx 30rpx;
  background: #ffffff;
  border: 2rpx solid #F0E2D6;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #555;
  transition: all .15s;
  box-sizing: border-box;
  min-height: 72rpx;
}
.chip.sel {
  background: #FFF1E8;
  border-color: #FF8C42;
  color: #E8533E;
  font-weight: 600;
}
.chip.allergen {
  border-style: dashed;
  border-color: #FF8C42;
}

/* 两级联动：大类横向平铺；小类以浮层挂在大类正下方，绝不撑宽大类 */
.hier {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hier {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.hier-head {
  display: flex;
  align-items: center;
}
.hier-chip {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
}
.chev {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 40rpx;
  font-size: 24rpx;
  color: #FF8C42;
  margin-left: 6rpx;
  border-radius: 12rpx;
  background: rgba(255,140,66,0.08);
  flex-shrink: 0;
}
.subgrid {
  position: absolute;
  top: 96rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #FFE3D0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .10);
}
.chip.subchip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  min-width: 160rpx;
  box-sizing: border-box;
}

.sub { font-size: 28rpx; color: #888; margin: 16rpx 0 20rpx; }

.selected {
  margin: 24rpx 0;
  font-size: 26rpx;
  color: #FF8C42;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}
.half { flex: 1; }

.tip {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

.scene-hint {
  font-size: 24rpx;
  color: #E8533E;
  background: #FFF1E8;
  border: 2rpx solid #FFD9C2;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-top: 16rpx;
  line-height: 1.5;
}



.drink-warn {
  font-size: 24rpx;
  color: #B26A00;
  background: #FFF7E6;
  border: 2rpx solid #FFD591;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

.form-warn {
  font-size: 24rpx;
  color: #B26A00;
  background: #FFF7E6;
  border: 2rpx solid #FFD591;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}



/* 忌口冲突自绘弹层 */
.conflict-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.conflict-box {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.conflict-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}
.conflict-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.conflict-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 320rpx;
  overflow-y: auto;
  margin-bottom: 28rpx;
}
.conflict-item {
  font-size: 26rpx;
  color: #E8533E;
}
.conflict-actions {
  display: flex;
  gap: 20rpx;
}
.conflict-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 1.4;
  padding: 18rpx 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  text-align: center;
}
.conflict-btn::after { border: none; }
.conflict-btn.ghost {
  background: #F5F5F5;
  color: #666;
}
.conflict-btn.primary {
  background: #E8533E;
  color: #fff;
}

/* 隐私未授权提示条（拒绝后不退出，引导重新授权） */
.privacy-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF3E8;
  border: 2rpx solid #FFD9BC;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin: 20rpx 0 20rpx;
}
.privacy-text {
  flex: 1;
  font-size: 24rpx;
  color: #C8742E;
  line-height: 1.4;
}
.privacy-btn {
  margin-left: 20rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: #FF8C42;
  padding: 12rpx 26rpx;
  border-radius: 26rpx;
}

  /* 原生 checkbox-group 分组多选（菜系/主食/肉类/菜类/配饮）；置于底部弹层内，
   滚动区最多占 1/3 屏，小类超过即内部滚动，不盖满整屏 */
.hg-scroll {
  max-height: 33vh;
  background: #ffffff;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

/* 大类专属弹窗内：小类相对大类缩进，层级更清晰 */
.sheet .hg-child { padding-left: 44rpx; }

/* 底部「大类专属弹窗」：遮罩 + 底部滑出卡片 */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 9000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  animation: sheetUp .22s ease-out;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.sheet-done {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF8C42;
  padding: 8rpx 20rpx;
}
.sheet-done:active { opacity: .6; }
.search-bar {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 16rpx;
  padding: 12rpx 20rpx;
  background: #F7F2EC;
  border: 2rpx solid #F0E2D6;
  border-radius: 999rpx;
}
.search-ico { font-size: 26rpx; margin-right: 8rpx; }
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-clear {
  font-size: 26rpx;
  color: #bbb;
  padding: 0 6rpx;
}
.search-clear:active { color: #999; }
.sheet-scroll { flex: 1; }
.hg { display: block; }
.hg-group {
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F7EFE8;
}
.hg-group:last-child { border-bottom: none; }
.hg-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}
.hg-children {
  padding-left: 56rpx;
  display: flex;
  flex-direction: column;
}
.hg-child { min-height: 66rpx; }
.hg-label {
  font-size: 30rpx;
  color: #555;
  margin-left: 12rpx;
}
.hg-alias {
  font-size: 24rpx;
  color: #B0A39A;
  margin-left: 8rpx;
}
.hg-parent .hg-label {
  font-weight: 600;
  color: #333;
}
/* 原生 checkbox 视觉收敛，主题色由 color 属性统一控制 */
.hg checkbox { transform: scale(0.92); }
