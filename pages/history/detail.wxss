.page { padding: 32rpx; }

.list-add-btn {
  margin: 32rpx 0 16rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #E8533E 100%);
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.32);
}
.list-add-btn:active { opacity: .88; }

/* B2 做过了？入口：右侧按钮组一员 */
.rate-mini {
  min-width: 130rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 14rpx;
  border-radius: 28rpx;
  background: transparent;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  z-index: 3;
  box-sizing: border-box;
}
.rate-mini .rated { color: #bbb; border-color: #ddd; }
.rate-mini .rated-good { color: #FF5B5B; }
.rate-mini .rated-normal { color: #F5B800; }
.rate-mini .rated-bad { color: #333333; }
.rate-mini:active { background: #FFF1E8; }

/* 去外卖：右侧按钮组一员（单菜跳转） */
.takeout-btn {
  min-width: 130rpx;
  text-align: center;
  background: transparent;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 14rpx;
  border-radius: 28rpx;
  z-index: 3;
  box-sizing: border-box;
}
.takeout-btn:active { background: #FFF1E8; }

/* 去外卖：自绘平台选择弹窗（底部弹出，与 shoplist 一致） */
.takeout-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; justify-content: center; z-index: 220; }
.takeout-box { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.takeout-title { text-align: center; font-size: 32rpx; font-weight: 800; color: #333; }
.takeout-sub { text-align: center; font-size: 22rpx; color: #aaa; margin: 8rpx 0 24rpx; }
.takeout-opt { display: flex; align-items: center; padding: 24rpx 20rpx; border-radius: 18rpx; background: #FDF8F4; margin-bottom: 16rpx; }
.takeout-opt:active { background: #F6EFE8; }
.takeout-ico { width: 56rpx; height: 56rpx; border-radius: 50%; color: #fff; font-size: 28rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.takeout-ico.meituan { background: #FFD100; color: #3B2F00; }
.takeout-ico.taobao { background: #FF5000; }
.takeout-ico.jd { background: #E1251B; }
.takeout-label { font-size: 30rpx; color: #333; font-weight: 600; }
.takeout-cancel { text-align: center; font-size: 30rpx; color: #999; padding: 24rpx 0 8rpx; margin-top: 8rpx; border-top: 2rpx solid #F2ECE6; }
.takeout-cancel:active { color: #666; }

/* B2 评价弹窗 */
.rate-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rate-box {
  width: 78%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 28rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.18);
}
.rate-box .claim-title { margin-bottom: 28rpx; }
.rate-btns { display: flex; gap: 16rpx; }
.rate-tag { flex: 1; text-align: center; font-size: 26rpx; padding: 18rpx 0; border-radius: 30rpx; border: 2rpx solid #EEE5DD; color: #666; background: #fff; }
.rate-tag.good:active { background: #EAF7EE; border-color: #7BC78E; color: #2E8B57; }
.rate-tag.normal:active { background: #F6EFE8; border-color: #E0D5CB; }
.rate-tag.bad:active { background: #FDECEC; border-color: #E8533E; color: #E8533E; }
.rate-cancel {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: #FF8C42;
  padding: 18rpx 0;
  border-radius: 30rpx;
}

.date {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
  text-align: center;
}

.scene-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E8533E;
  margin: 20rpx 0 12rpx;
}
.scene-title:first-child { margin-top: 0; }

.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: #FF8C42;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}
.dish {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  margin-bottom: 16rpx;
  min-height: 320rpx;
  box-shadow:0 6rpx 20rpx rgba(0,0,0,0.04);
}

/* 右侧按钮组：占满卡片高度并垂直居中，避免贴顶或贴底导致上下失衡 */
.dish-actions {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 14rpx;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 18rpx;
}
.img {
  width: 140rpx; height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #FFE6D5;
}
.img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.info { flex: 1; min-width: 0; padding-right: 168rpx; box-sizing: border-box; }
.name { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 10rpx; }
.nutri { font-size: 23rpx; margin-right: 30rpx; }
.nutri .row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F6EFE8;
}
.nutri .k { width: 150rpx; color: #999; flex-shrink: 0; }
.nutri .v { flex: 1; color: #444; }

.pick {
  position: absolute;
  top: 14rpx; right: 14rpx;
  background: #FF8C42;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 「看做法」按钮：右侧按钮组一员，透明背景 + 描边 */
.cook-btn {
  min-width: 130rpx;
  text-align: center;
  background: transparent;
  color: #E8533E;
  border: 2rpx solid #E8533E;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 14rpx;
  border-radius: 28rpx;
  z-index: 3;
  box-sizing: border-box;
}
.add-list-btn {
  min-width: 130rpx;
  text-align: center;
  background: transparent;
  color: #5BB87A;
  border: 2rpx solid #5BB87A;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 14rpx;
  border-radius: 28rpx;
  z-index: 3;
  box-sizing: border-box;
}
.add-list-btn:active { background: #EAF8EF; }
.add-list-btn.done {
  color: #B6BEB6;
  border-color: #DCE2DC;
  background: #F4F6F4;
}

/* 做法弹层 */
.guide-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}
.guide-box {
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.guide-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}
.guide-diff-center {
  text-align: center;
  margin: 10rpx 0 14rpx;
}
/* 标题右侧：线条五角星收藏按钮 */
.fav-btn {
  margin-left: 16rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #C9A24B;
  padding: 0 6rpx;
}
.fav-btn.on { color: #FFB020; }
.fav-btn.disabled { opacity: 0.35; pointer-events: none; }
.fav-count {
  font-size: 22rpx;
  color: #B0B0B0;
  margin-left: 8rpx;
  font-weight: 400;
}

/* 收藏选择弹层 */
.fav-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 48rpx;
}
.fav-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.fav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #333;
  text-align: center;
}
.fav-sub {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin: 14rpx 0 28rpx;
  line-height: 1.6;
}
.fav-opt {
  border: 2rpx solid #F0E6DC;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
}
.fav-opt.cloud { border-color: #FFD9B8; background: #FFF8F1; }
.fav-opt-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: flex;
  align-items: center;
}
.fav-opt-tag {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}
.fav-opt-tag.free { color: #2BA471; background: #E6F6EE; }
.fav-opt-tag.cost { color: #E8533E; background: #FDE9E2; }
.fav-opt-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.fav-cancel {
  margin-top: 24rpx;
}
.guide-loading {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}
.guide-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  padding-right: 12rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.guide-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.guide-tag {
  font-size: 24rpx;
  color: #E8533E;
  background: #FFF0EB;
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  line-height: 1.4;
}
.guide-tag.diff {
  background: #FFE1D8;
  font-weight: 700;
}
.guide-sec {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8533E;
  margin: 20rpx 0 12rpx;
}
.guide-li {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
}
.guide-season {
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.7;
  margin: 4rpx 0 12rpx;
  word-break: break-all;
}
.guide-report {
  font-size: 24rpx;
  color: #b0a89a;
  text-align: center;
  margin: 20rpx 0 6rpx;
  text-decoration: underline;
}
.rep-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 400; }
.rep-box { width: 84%; background: #fff; border-radius: 20rpx; padding: 30rpx 28rpx 24rpx; box-sizing: border-box; }
.rep-title { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; }
.rep-text { width: 100%; height: 220rpx; box-sizing: border-box; border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; line-height: 1.5; color: #444; background: #fafafa; }
.rep-ph { color: #bbb; }
.rep-actions { display: flex; margin-top: 24rpx; }
.rep-btn { flex: 1; text-align: center; font-size: 30rpx; padding: 18rpx 0; border-radius: 30rpx; }
.rep-btn.cancel { color: #666; background: #f2f2f2; margin-right: 16rpx; }
.rep-btn.ok { color: #fff; background: #FF8C42; font-weight: 700; }
.guide-empty {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  padding: 40rpx 0;
}
.guide-review {
  font-size: 27rpx;
  color: #555;
  line-height: 1.7;
  background: #FFF6F0;
  border-left: 6rpx solid #FF8C42;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 8rpx;
}
.guide-close {
  margin-top: 28rpx;
  text-align: center;
  background: #FF8C42;
  color: #fff;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
}
.guide-close.disabled { background: #CCC; color: #fff; pointer-events: none; }

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}


