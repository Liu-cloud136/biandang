  opacity: 0.8;
}
/* 「想尝试一些其他的？」按钮：位于各品类区尾部，虚线胶囊，弱化但可点击 */
.try-btn {
  margin: 16rpx auto 4rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #FF8C42;
  background: #FFF7F0;
  border: 2rpx dashed #FFB27A;
  border-radius: 999rpx;
  text-align: center;
}
.try-btn:active {
  opacity: 0.7;
  background: #FFEFE2;
}
.cook-btn-inline {
  display: inline-block;
  color: #E8533E;
  border: 2rpx solid #E8533E;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 22rpx;
  margin-left: 10rpx;
  line-height: 1.6;
  white-space: nowrap;
  flex-shrink: 0;
}
/* 菜名旁菜系标签：淡绿描边小标签 */
.cuisine-tag {
  display: inline-block;
  color: #2f9e57;
  background: #eafaf0;
  border: 2rpx solid #bfe9cd;
  font-size: 20rpx;
  padding: 1rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
  line-height: 1.6;
  white-space: nowrap;
  flex-shrink: 0;
}
.cook-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}
.cook-box {
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.cook-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.cook-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}
.cook-head .fav-btn {
  font-size: 36rpx;
  color: #ccc;
}
.cook-head .fav-btn.disabled { opacity: 0.35; pointer-events: none; }
.cook-head .fav-btn.on { color: #FFB020; }
.cook-head .fav-count {
  font-size: 22rpx;
  color: #999;
}
.cook-meta-center {
  text-align: center;
  margin: 10rpx 0 14rpx;
}
.cook-loading {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}
.cook-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
  padding-right: 12rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.cook-tag {
  font-size: 24rpx;
  color: #E8533E;
  background: #FFF0EB;
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  line-height: 1.4;
}
.cook-tag.diff {
  background: #FFE1D8;
  font-weight: 700;
}
.cook-sec {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8533E;
  margin: 20rpx 0 12rpx;
}
.cook-li {
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
}
.cook-season {
  font-size: 26rpx;
  color: #8a8a8a;
  line-height: 1.7;
  margin: 4rpx 0 12rpx;
  word-break: break-all;
}
.cook-report {
  font-size: 24rpx;
  color: #b0a89a;
  text-align: center;
  margin: 20rpx 0 6rpx;
  text-decoration: underline;
}
.rep-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 400; }
.rep-box { width: 84%; background: #fff; border-radius: 20rpx; padding: 30rpx 28rpx 24rpx; box-sizing: border-box; }
.rep-title { font-size: 30rpx; font-weight: 700; color: #333; margin-bottom: 20rpx; }
.rep-text { width: 100%; height: 220rpx; box-sizing: border-box; border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; line-height: 1.5; color: #444; background: #fafafa; }
.rep-ph { color: #bbb; }
.rep-actions { display: flex; margin-top: 24rpx; }
.rep-btn { flex: 1; text-align: center; font-size: 30rpx; padding: 18rpx 0; border-radius: 30rpx; }
.rep-btn.cancel { color: #666; background: #f2f2f2; margin-right: 16rpx; }
.rep-btn.ok { color: #fff; background: #FF8C42; font-weight: 700; }
.cook-empty {
  font-size: 26rpx;
  color: #bbb;
}
.cook-review {
  font-size: 27rpx;
  color: #555;
  line-height: 1.7;
  background: #FFF6F0;
  border-left: 6rpx solid #FF8C42;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 8rpx;
}
.cook-close-btn {
  margin-top: 28rpx;
  text-align: center;
  background: #FF8C42;
  color: #fff;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
}
.cook-close-btn.disabled { background: #CCC; color: #fff; pointer-events: none; }
/* 收藏选择弹层（复用历史详情页样式） */
.fav-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 48rpx;
}
.fav-box {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.fav-opt {
  border: 2rpx solid #F0E6DC;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
}
.fav-opt.cloud { border-color: #FFD9B8; background: #FFF8F1; }
.fav-opt-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: flex;
  align-items: center;
}
.fav-opt-tag {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}
.fav-opt-tag.free { color: #2BA471; background: #E6F6EE; }
.fav-opt-tag.cost { color: #E8533E; background: #FDE9E2; }
.fav-opt-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.fav-cancel {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  padding: 18rpx 0 4rpx;
}

/* 反馈弹层：多选选项 */
.fb-options {
  margin: 20rpx 0 8rpx;
}
.fb-divider {
  margin: 24rpx 0 12rpx;
  font-size: 22rpx;
  color: #b08968;
  text-align: center;
}
.fb-opt {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #EEE;
  border-radius: 16rpx;
  font-size: 29rpx;
  color: #444;
}
.fb-opt.on {
  border-color: #E8533E;
  background: #FFF5F1;
  color: #E8533E;
}
.fb-check {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #CCC;
  border-radius: 50%;
  margin-right: 20rpx;
  position: relative;
  flex-shrink: 0;
}
.fb-opt.on .fb-check {
  border-color: #E8533E;
  background: #E8533E;
}
.fb-opt.on .fb-check::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 8rpx;
  height: 15rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}
.fb-note {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  border: 2rpx solid #EEE;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 27rpx;
  color: #333;
  margin-top: 8rpx;
}

/* 服务器状态指示：🌐 + 绿点（置于领次数/签到正下方） */
.server-status {
  display: inline-flex;
  align-self: flex-end;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34C759;
  box-shadow: 0 0 6rpx rgba(52, 199, 89, 0.6);
  flex-shrink: 0;
  box-sizing: border-box;
}
.status-dot.down {
  background: #FF3B30;
  box-shadow: 0 0 6rpx rgba(255, 59, 48, 0.6);
}
.status-dot.noloc {
  background: #FFB300;
  box-shadow: 0 0 6rpx rgba(255, 179, 0, 0.6);
}
.server-status.noloc {
  border-color: #FFB300;
  color: #B8860B;
}
/* 需求1：服务正常（已定位）不可点击，视觉上降透明、禁 hover */
.server-status.disabled {
  opacity: 0.65;
}
.server-status-hover {
  opacity: 0.7;
}
.status-text {
  line-height: 1;
}

/* 单场景空态兜底（出文通道繁忙导致该场景空白时，提示并可单场景重试） */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 28rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip-text {
  margin-bottom: 18rpx;
}


