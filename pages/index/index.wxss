/* 与「我的」等其它页一致：整页原生滚动，内容全部显示；底部留位给自定义 tabBar（胶囊） */
.page {
  box-sizing: border-box;
  /* flex column + min-height:100vh：引导态让 .hero-wrap 用 flex:1 占满导航下方剩余空间，
     整页恰好一屏、hero 垂直居中、不滚动；结果态内容长时仍正常原生滚动 */
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 底部留位给悬浮胶囊：胶囊顶边在屏幕底 212rpx（bottom:72 + 自身140） */
  padding: 24rpx 32rpx calc(250rpx + env(safe-area-inset-bottom));
}
/* 顶部区（次数栏/公告/状态点）：奶油背景与页面同色(#FDF8F4)，普通块。
   与「我的」等其它页一致 —— 不吸顶、不悬浮，随整页内容一起向上滚动；
   不再用 position:sticky（sticky 在部分基础库下会 glitch，导致结果卡滚到导航上方/上层）。
   导航即 .page 的第一个块，内容全部显示、无重叠、无遮挡。 */
.top {
  background: #FDF8F4;
  display: flex;
  flex-direction: column;
}
/* 引导态：位于悬浮导航(.top)下方；用 flex:1 占满 .page 剩余空间（.page 已 min-height:100vh），
   整页恰好一屏、hero 垂直居中、不溢出滚动。
   flex column 主轴竖直(justify-content:center 垂直居中)，交叉轴水平默认 stretch 让 .hero 撑满宽度，
   文字由 .hero 的 text-align:center 居中。注意：禁用固定 75vh，否则 +top区 +底部留位 > 100vh 会重新出现滚动。 */
.hero-wrap {
  margin-top: 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 决定中：进度模式弹窗（标注关键点，缓解等待焦虑） */
.prog-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.prog-box {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 52rpx 44rpx 44rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}
.prog-emoji {
  font-size: 68rpx;
  text-align: center;
  margin-bottom: 14rpx;
}
/* 出文弹窗期间顶部 emoji 常驻轻微摇摆，传递"进行中"的活动感；block+text-align 保证居中 */
.prog-emoji--swing {
  display: block;
  width: 100%;
  text-align: center;
  animation: progEmojiSwing 1.4s ease-in-out infinite;
  transform-origin: 50% 80%;
}
@keyframes progEmojiSwing {
  0%, 100% { transform: rotate(-8deg) translateY(0); }
  50% { transform: rotate(8deg) translateY(-4rpx); }
}
.prog-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 36rpx;
}
/* 方案 A：单条真实计数进度（出文+出图并行统一反映） */
.prog-sub {
  text-align: center;
  font-size: 25rpx;
  color: #999;
  margin-bottom: 26rpx;
}
.prog-bar {
  position: relative;
  margin: 0 auto 16rpx;
  width: 100%;
  height: 12rpx;
  background: #f0f0f3;
  border-radius: 6rpx;
  overflow: hidden;
}
.prog-fill {
  position: relative;
  overflow: hidden;
  height: 100%;
  background: linear-gradient(90deg, #FFB347, #FF8C42);
  border-radius: 6rpx;
  transition: width 0.18s ease;
}
/* 流动光泽：真实计数可能短暂不变，高光在跑避免"卡住"观感 */
.prog-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 40%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
  animation: progshimmer 1.1s linear infinite;
}
@keyframes progshimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(350%); }
}
/* 起步不确定态：进度条改为纯 CSS 流光（无确定宽度，光带横扫），真实计数接管后切回实条。
   覆盖 .prog-fill 的橙色实体，改用半透明底 + 流动高光，避免"假填充到 10%"的突兀感。 */
.prog-bar--indet .prog-fill {
  width: 100% !important;
  background: #f0f0f3;
  transition: none;
}
.prog-bar--indet .prog-fill::after {
  width: 45%;
  background: linear-gradient(90deg, transparent, #FFB347, #FF8C42, transparent);
  animation: progIndet 1.3s ease-in-out infinite;
}
@keyframes progIndet {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(280%); }
}
/* 起步不确定态：emoji 叙事剧场（🤖→🤖🍳→🍳→🍲 循环），替代静态文案 */
.prog-story {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
}
.prog-story-emoji {
  font-size: 30rpx;
  opacity: 0;
  transform: translateY(4rpx) scale(0.8);
  animation: progStoryPop 3.2s ease-in-out infinite;
}
.prog-story-emoji.s1 { animation-delay: 0.8s; }
.prog-story-emoji.s2 { animation-delay: 1.6s; }
.prog-story-emoji.s3 { animation-delay: 2.4s; }
@keyframes progStoryPop {
  0%, 100% { opacity: 0; transform: translateY(4rpx) scale(0.8); }
  12%, 22% { opacity: 1; transform: translateY(0) scale(1.12); }
  30% { opacity: 0; transform: translateY(-4rpx) scale(0.9); }
}
.prog-count {
  text-align: center;
  font-size: 24rpx;
  color: #FF8C42;
  font-weight: 600;
}

/* 尝鲜「想尝试一些其他的？」自绘加载弹窗（替代 wx.showLoading） */
.try-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.try-box {
  width: 540rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 44rpx 44rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.try-spin {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #ffe2cc;
  border-top-color: #FF8C42;
  border-radius: 50%;
  animation: try-rotate 0.8s linear infinite;
  margin-bottom: 28rpx;
}
@keyframes try-rotate { to { transform: rotate(360deg); } }
.try-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.try-slogan {
  font-size: 26rpx;
  color: #b09a78;
  min-height: 36rpx;
  margin-bottom: 32rpx;
  text-align: center;
}
.try-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f3;
  border-radius: 6rpx;
  overflow: hidden;
}
.try-fill {
  position: relative;
  overflow: hidden;
  height: 100%;
  background: #FF8C42;
  border-radius: 6rpx;
  transition: width 0.32s ease;
  min-width: 16%;   /* 加载中基底宽度：即使 tryProgress 暂为 0，也保留流动光泽条，丝滑表达"生成中"；完成时 width:100% 自然覆盖。不伪造百分比数值。 */
}
.try-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(100deg, rgba(255,255,255,0) 30%, rgba(255,255,255,0.55) 50%, rgba(255,255,255,0) 70%);
  background-size: 200% 100%;
  animation: try-shine 1.2s linear infinite;
}
@keyframes try-shine { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
.try-pct {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FF8C42;
  font-weight: 600;
  align-self: flex-end;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.free { font-size: 26rpx; color: #888; }
.tip {
  font-size: 26rpx;
  color: #FF8C42;
  background: transparent;
  border: 2rpx solid #FF8C42;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}
.top-actions { display: flex; align-items: center; gap: 16rpx; }
.tip.signed { background: #cccccc; border-color: #cccccc; color: #fff; }
.tip.disabled { color: #bbb; background: #f0f0f0; border-color: #e5e5e5; }

/* 免费次数：可点击查看明细 */
.free {
  font-size: 26rpx;
  color: #888;
  display: flex;
  align-items: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

/* 免费次数明细弹层 */
.fl-box { width: 600rpx; }
.fl-summary {
  font-size: 24rpx;
  color: #666;
  background: #F7F7F9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.fl-list { max-height: 560rpx; }
.fl-empty { font-size: 24rpx; color: #bbb; text-align: center; padding: 60rpx 0; }
.fl-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #F0F0F2;
}
.fl-info { flex: 1; min-width: 0; }
.fl-name { font-size: 28rpx; color: #333; }
.fl-right { text-align: right; margin-left: 16rpx; }
.fl-amt { font-size: 32rpx; font-weight: 700; }
.fl-amt.plus { color: #2BA471; }
.fl-amt.minus { color: #E8533E; }
.fl-time { font-size: 20rpx; color: #bbb; margin-top: 4rpx; }

/* 通知栏（不可点击、不弹窗、黄色栏内跑马灯滚动、持久化） */
.announce {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF7E6;
  border: 2rpx solid #FFE0A3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.announce-icon { font-size: 28rpx; flex-shrink: 0; }
.announce-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  position: relative;
}
.announce-marquee {
  display: inline-block;
  white-space: nowrap;
  padding-left: 100%;
  animation: bd-marquee 65s linear infinite;
  font-size: 26rpx;
  color: #B26A00;
}
@keyframes bd-marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}

/* 引导弹窗动作区（新用户引导 / 结果引导）：与出文耗时弹窗同一版式——
   图标/标题/说明复用 latency-tip-*；按钮同宽纵向堆叠（主渐变在上、次描边在下），宽松不挤 */
.nu-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;   /* desc 自带 mb24rpx，合计 44rpx，与出文耗时弹窗 points→按钮 间距一致 */
}
.nu-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}
.nu-btn.primary {
  background: linear-gradient(135deg, #FF8C42, #E8533E);
  color: #fff;
}
.nu-btn.ghost {
  background: #fff;
  color: #B26A00;
  border: 2rpx solid #F0C193;
}
.nu-btn:active { opacity: .85; }

/* 引导 */
.hero {
  text-align: center;
}
.emoji { font-size: 120rpx; }
.q { font-size: 52rpx; font-weight: 800; color: #333; margin: 16rpx 0; }
.sub { font-size: 28rpx; color: #999; margin-bottom: 28rpx; }
.decide { width: 70%; margin: 0 auto; }
.decide.loading { background: #FFB98C; }

/* B 类三个工具入口：与「使用说明」同款下划线文字链，横排居中，不抢主按钮视觉 */
.hero-tools {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 24rpx;
  margin: 40rpx 8rpx 0;
}
.tool-link {
  font-size: 26rpx;
  color: #FF8C42;
  line-height: 1.6;
  border-bottom: 2rpx solid #FF8C42;
  padding-bottom: 2rpx;
}
.tool-link:active { opacity: .6; }
/* 使用说明：原来的下划线橙小链接 */
.guide-entry {
  margin: 20rpx auto 0;
  font-size: 26rpx;
  color: #FF8C42;
  border-bottom: 2rpx solid #FF8C42;
  padding-bottom: 2rpx;
  display: inline-block;
}

/* 悬浮工具按钮：左侧公告栏下方，三个图标竖排圆钮 */
.fab {
  position: fixed;
  left: 24rpx;
  top: calc(210rpx + env(safe-area-inset-top));
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.fab-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #FFD9C2;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(255,140,66,0.18);
}
.fab-btn:active { background: #FFF1E8; }

/* 结果（推荐详情组件 / 推荐详情）：整页原生滚动，本卡为普通块置于悬浮导航(.top)下方，
   内容全部显示、整页滚动到底，无内滚、无穿出；顶部留 24rpx 间距，四角圆角白卡浮于奶油背景 */
.result {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  /* 底部 padding 用 20rpx：卡的白底边与三个操作按钮间留 20rpx 间距；其余三边不变 */
  padding: 24rpx 24rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,140,66,0.10);
  box-sizing: border-box;
}
.dish {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  margin-bottom: 16rpx;
  background: #FDF8F4;
}
.dish.sel {
  background: #FFF1E8;
  border-color: #FF8C42;
}
.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #FFE6D5;
}
.dish-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.dish-info { flex: 1; min-width: 0; }
.dish-name { font-size: 30rpx; font-weight: 700; color: #333; }
.dish-reason { font-size: 23rpx; color: #666; margin: 8rpx 0; line-height: 1.5; }

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
  /* 底部不留空白：间距统一由 .result 的 padding-bottom:8rpx 提供，避免叠加成 16rpx */
  margin-bottom: 0;
}
.actions .btn-primary,
.actions .btn-ghost { flex: 1; min-width: 0; }

/* 提交/换批进行中：置灰禁用，防重复点击 */
.actions .btn-primary.disabled,
.actions .btn-ghost.disabled { opacity: 0.45; pointer-events: none; }

.scene-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E8533E;
  margin: 20rpx 0 12rpx;
}
.scene-title:first-child { margin-top: 0; }

.block-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8533E;
  margin: 28rpx 0 12rpx;
}
.dish.staple { background: #F4F8FF; }
.dish.staple.sel {
  background: #EAF1FF;
  border-color: #4A90E2;
}

