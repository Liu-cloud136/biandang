            <view class="fl-amt {{item.type === 'add' ? 'plus' : 'minus'}}">{{item.type === 'add' ? '+' : '-'}}{{item.amount}}</view>
            <view class="fl-time">{{item.ts}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="claim-actions">
        <view class="claim-btn confirm" bindtap="onFreeLogClose">知道了</view>
      </view>
    </view>
  </view>

  <!-- 决定中：真实计数连续进度（方案 A，出文与出图并行，统一用一条真实进度反映） -->
  <view wx:if="{{progress.show}}" class="prog-mask" catchtap="noop" catchtouchmove="noop">
    <view class="prog-box" catchtap="noop">
      <view class="prog-emoji prog-emoji--swing">🤔</view>
      <view class="prog-title">{{progress.isChangeBatch ? '换一批中…' : '正在为你决定…'}}</view>
      <view class="prog-sub">正在搭配菜品，请稍候…</view>
