  <view wx:if="{{showCook}}" class="cook-mask" bindtap="closeCook" catchtouchmove="noop">
    <view class="cook-box" catchtap="noop">
      <view class="cook-head">
        <view class="cook-title">{{guideDish}} · 做法</view>
        <view class="fav-btn {{cookFav ? 'on' : ''}} {{guideLoading ? 'disabled' : ''}}" catchtap="onOpenCookFav">{{cookFav ? '★' : '☆'}}</view>
        <text class="fav-count" wx:if="{{cookFavCount != null && cookFavCount > 0}}">{{cookFavCount}}</text>
      </view>
      <view wx:if="{{cookGuide && cookGuide.difficulty}}" class="cook-meta-center">
        <text class="cook-tag diff">难度 · {{cookGuide.difficulty}}</text>
      </view>
      <view wx:if="{{guideLoading}}" class="cook-loading">准备中…</view>
      <scroll-view wx:else scroll-y class="cook-scroll">
        <view class="cook-sec">所需食材</view>
        <view wx:if="{{cookGuide.ingMain && cookGuide.ingMain.length}}">
          <view wx:for="{{cookGuide.ingMain}}" wx:for-item="ing" wx:key="*this" class="cook-li">· {{ing}}</view>
        </view>
        <view wx:if="{{cookGuide.seasonLine}}" class="cook-season">调料：{{cookGuide.seasonLine}}</view>
        <view wx:if="{{!(cookGuide.ingMain && cookGuide.ingMain.length) && !cookGuide.seasonLine}}" class="cook-empty">暂无食材信息</view>
        <view class="cook-sec">烹饪步骤</view>
        <view wx:for="{{cookGuide.steps}}" wx:for-item="st" wx:for-index="si2" wx:key="index" class="cook-li">{{si2 + 1}}. {{st}}</view>
        <view wx:if="{{!cookGuide.steps.length}}" class="cook-empty">暂无步骤信息</view>
        <block wx:if="{{cookGuide.tips}}">
          <view class="cook-sec">小贴士</view>
          <view class="cook-review">{{cookGuide.tips}}</view>
        </block>
        <view class="cook-sec">点评</view>
        <view wx:if="{{cookGuide.review}}" class="cook-review">{{cookGuide.review}}</view>
        <view wx:else class="cook-empty">暂无点评</view>
        <view class="cook-report" catchtap="onReportDish" data-name="{{guideDish}}">不喜欢 / 觉得有问题？反馈一下</view>
      </scroll-view>
      <view class="cook-close-btn {{guideLoading ? 'disabled' : ''}}" bindtap="closeCook">关闭</view>
    </view>
  </view>

  <!-- 收藏选择弹层（复用历史详情页模式） -->
  <view wx:if="{{showFav}}" class="fav-mask" bindtap="onCloseFav" catchtouchmove="noop">
    <view class="fav-box" catchtap="noop">
      <view class="fav-opt" bindtap="onFavLocal">
        <view class="fav-opt-main">{{favLocal ? '取消本地收藏' : '收藏到本地'}}</view>
        <view class="fav-opt-desc">{{favLocal ? '已在本机保留' : '即时保存，仅本机'}}</view>
      </view>
      <view class="fav-opt cloud" bindtap="onFavCloud">
        <view class="fav-opt-main">{{favCloud ? '取消云端收藏' : '收藏到云端'}}<text class="fav-opt-tag cost" wx:if="{{!favCloud}}">耗 1 次</text></view>
        <view class="fav-opt-desc">{{favCloud ? '已跨设备同步' : '跨设备保留，消耗免费次数'}}</view>
      </view>
      <view class="fav-cancel" bindtap="onCloseFav">取消</view>
    </view>
  </view>

  <!-- 反馈补充说明（阶段5② 自定义大输入框，替代系统 editable 弹窗） -->
  <view wx:if="{{rep.show}}" class="rep-mask" bindtap="onRepNoteCancel" catchtouchmove="noop">
    <view class="rep-box" catchtap="noop">
      <view class="rep-title">补充说明（选填）</view>
      <textarea class="rep-text" value="{{rep.text}}" bindinput="onRepNoteInput" maxlength="200"
        placeholder="例如：盐太多 / 搭配奇怪 / 步骤不对（最多 200 字）" placeholder-class="rep-ph" cursor-spacing="12"></textarea>
      <view class="rep-actions">
        <view class="rep-btn cancel" catchtap="onRepNoteCancel">取消</view>
        <view class="rep-btn ok" catchtap="onRepNoteSubmit">提交</view>
      </view>
    </view>
  </view>
</view>
