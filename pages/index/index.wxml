  <!-- 尝鲜「想尝试一些其他的？」加载：自绘进度条 + 轮播标语（替代系统 wx.showLoading） -->
  <view wx:if="{{tryLoading}}" class="try-mask" catchtap="noop" catchtouchmove="noop">
