        <view class="prog-fill" style="width: {{progress.pct}}%;"></view>
      </view>
      <view class="prog-count">
        <view wx:if="{{progress.indeterminate}}" class="prog-story">
          <text class="prog-story-emoji s0">🤔</text>
          <text class="prog-story-emoji s1">🤔🍳</text>
          <text class="prog-story-emoji s2">🍳</text>
          <text class="prog-story-emoji s3">🍲</text>
