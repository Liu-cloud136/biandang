.page {
  min-height: calc(100vh - var(--nav-h, 88rpx));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.page > view { width: 100%; }

/* 作者介绍区 */
.hero { text-align: center; padding: 0 0 16rpx; width: 100%; box-sizing: border-box; }
.hero-avatar {
  width: 200rpx; height: 200rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  background: #FDF8F4;
}
/* 图片填满圆形宽度、高度超出并顶部对齐：王冠完整贴圆顶、底部被裁、无顶部空白 */
.hero-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 130%;
  display: block;
}
.hero-name {
  font-size: 40rpx; font-weight: 800; color: #333;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
}

/* 平台账号：居中平铺换行，紧贴标题下 */
.platform-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0 0;
  width: 100%;
  box-sizing: border-box;
}

/* 徽章：左标签 + 右值，整体一个连续外框 */
.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 8rpx;
  overflow: hidden;
  border: 2rpx solid #333;
  font-size: 24rpx;
  line-height: 1;
}
.badge-label {
  background: transparent;
  color: #555;
  padding: 12rpx 16rpx;
  font-weight: 600;
  border-right: 2rpx solid #333;
}
.badge-value {
  background: transparent;
  color: #333;
  padding: 12rpx 16rpx;
  font-weight: 600;
  font-size: 20rpx;
}
.platform:active { background: #FAF6F2; }

/* 特别鸣谢 */
.thanks {
  margin-top: 40rpx;
  padding: 0;
}
.thanks-title {
  font-size: 30rpx; font-weight: 700; color: #333;
  margin-bottom: 16rpx;
}
.thanks-body {
  font-size: 28rpx; color: #666; line-height: 44rpx;
}
