.page { padding: 32rpx 32rpx calc(240rpx + env(safe-area-inset-bottom)); }

.empty { text-align: center; color: #999; margin-top: 160rpx; font-size: 30rpx; }
.empty .emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.empty .sub { font-size: 24rpx; color: #bbb; margin-top: 12rpx; padding: 0 60rpx; line-height: 36rpx; }
.empty .link { margin-top: 32rpx; color: #FF8C42; font-size: 28rpx; }

.list { background: #fff; border-radius: 24rpx; padding: 8rpx 16rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04); }
.item { display: flex; align-items: center; padding: 22rpx 12rpx; border-bottom: 2rpx solid #F6EFE8; }
.item:last-child { border-bottom: none; }
.check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid #E0D5CB; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; }
.check.on { background: linear-gradient(135deg, #FF8C42, #E8533E); border-color: #FF8C42; }
.text { flex: 1; min-width: 0; margin: 0 16rpx; font-size: 30rpx; color: #333; word-break: break-all; line-height: 40rpx; }
.text:active { color: #FF8C42; }
.item.done .text { color: #bbb; text-decoration: line-through; }
.tag { flex-shrink: 0; font-size: 20rpx; color: #999; background: #F6EFE8; border-radius: 8rpx; padding: 4rpx 10rpx; }
.tag.hist { color: #FF8C42; background: #FFF1E8; }
.del { flex-shrink: 0; width: 52rpx; height: 52rpx; margin-left: 12rpx; color: #ccc; font-size: 30rpx; text-align: center; line-height: 52rpx; }
.del:active { color: #E8533E; }

.foot { display: flex; gap: 24rpx; margin-top: 40rpx; }
.foot-btn { flex: 1; text-align: center; border-radius: 48rpx; padding: 20rpx 0; font-size: 28rpx; }
.foot-btn.ghost { background: #fff; color: #FF8C42; border: 2rpx solid #FFD9C2; }
.foot-btn.ghost:active { background: #FFF1E8; }
.foot-btn.danger { background: #fff; color: #999; border: 2rpx solid #EEE5DD; }
.foot-btn.danger:active { background: #F7F2EE; }
.foot-btn.takeout { background: #fff; color: #FF8C42; border: 2rpx solid #FF8C42; font-weight: 700; }
.foot-btn.takeout:active { background: #FFF1E8; }

/* 去外卖：自绘平台选择弹窗 */
.takeout-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; justify-content: center; z-index: 120; }
.takeout-box { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.takeout-title { text-align: center; font-size: 32rpx; font-weight: 800; color: #333; }
.takeout-sub { text-align: center; font-size: 22rpx; color: #aaa; margin: 8rpx 0 24rpx; }
.takeout-opt { display: flex; align-items: center; padding: 24rpx 20rpx; border-radius: 18rpx; background: #FDF8F4; margin-bottom: 16rpx; }
.takeout-opt:active { background: #F6EFE8; }
.takeout-ico { width: 56rpx; height: 56rpx; border-radius: 50%; color: #fff; font-size: 28rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.takeout-ico.meituan { background: #FFD100; color: #3B2F00; }
.takeout-ico.taobao { background: #FF5000; }
.takeout-ico.jd { background: #E1251B; }
.takeout-label { font-size: 30rpx; color: #333; font-weight: 600; }
.takeout-cancel { text-align: center; font-size: 30rpx; color: #999; padding: 24rpx 0 8rpx; margin-top: 8rpx; border-top: 2rpx solid #F2ECE6; }
.takeout-cancel:active { color: #666; }

/* 列表上方提示 */
.tip { font-size: 22rpx; color: #b0a89e; text-align: center; margin: 4rpx 12rpx 28rpx; border: 2rpx solid #EFE6DC; border-radius: 12rpx; padding: 14rpx 16rpx; }

/* 食材详情弹窗（自绘，居中卡片，复用 genDetail 风格） */
.detail-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 48rpx; }
.detail-box { width: 100%; max-width: 560rpx; background: #fff; border-radius: 24rpx; padding: 36rpx 32rpx 28rpx; max-height: 84vh; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden; }
.detail-title { text-align: center; font-size: 32rpx; font-weight: 800; color: #333; margin-bottom: 16rpx; }
.detail-scroll { flex: 1; min-height: 0; max-height: 58vh; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 8rpx 4rpx 12rpx; }
.detail-ing { display: block; font-size: 27rpx; color: #444; line-height: 2; padding: 8rpx 16rpx; background: #FFF7F2; border-radius: 12rpx; margin-bottom: 12rpx; }
.detail-empty { font-size: 26rpx; color: #bbb; text-align: center; width: 100%; padding: 40rpx 0; }
.detail-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.detail-close { flex: 1; text-align: center; font-size: 30rpx; font-weight: 700; color: #fff; background: #FF8C42; padding: 20rpx 0; border-radius: 30rpx; }
.detail-copy { flex: 1; text-align: center; font-size: 30rpx; font-weight: 700; color: #FF8C42; background: #FFF1E8; border: 2rpx solid #FFD9C2; padding: 20rpx 0; border-radius: 30rpx; box-sizing: border-box; }
.detail-copy:active { background: #FFE2D0; }
