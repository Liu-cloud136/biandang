/* 推荐调校独立页面（2026-07-29） */
.tuning-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
  background: #FFF8F0;
}
.tuning-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tuning-row {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F6EFE8;
}
.tuning-row:last-of-type { border-bottom: none; }
.t-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 18rpx;
}
.t-desc {
  font-size: 22rpx;
  color: #aaa;
  margin: 6rpx 0 14rpx;
}
.t-ctrl {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.t-slider {
  flex: 1;
  margin: 0;
}
.t-val {
  flex-shrink: 0;
  width: 72rpx;
  text-align: right;
  font-size: 26rpx;
  color: #FF8C42;
  font-weight: 600;
}
.t-radio {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}
.t-radio-item {
  font-size: 24rpx;
  color: #555;
  display: flex;
  align-items: center;
  background: #f7f7f8;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}
.t-switch {
  transform: scale(0.85);
  transform-origin: left center;
}
.tuning-save {
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 30rpx;
  text-align: center;
  background: #FF8C42;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
}
.tuning-save.dis { opacity: 0.6; }

.tuning-guide {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 18rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.tg-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-bottom: 14rpx;
}
.tg-item {
  font-size: 23rpx;
  color: #888;
  line-height: 1.7;
  margin-bottom: 8rpx;
}
.tg-name {
  color: #555;
  font-weight: 600;
  margin-right: 8rpx;
}
