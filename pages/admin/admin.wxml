<!-- 一键入库自绘确认弹窗：显示入库/丢弃数量 + 将入库菜品清单，底部取消/确认 -->
<view class="alert-mask" wx:if="{{approveConfirm.show}}" bindtap="cancelApprove">
  <view class="alert-box approve-box" catchtap="noop">
    <view class="alert-title">确认一键入库</view>
    <view class="approve-stat">
      <text class="stat-ok">入库 {{approveConfirm.approveCount}} 道</text>
      <text class="stat-skip">丢弃(重复) {{approveConfirm.skipCount}} 道</text>
    </view>
    <view class="approve-sub">本次将入库以下菜品：</view>
    <scroll-view scroll-y class="approve-list">
      <view class="approve-item" wx:for="{{approveConfirm.list}}" wx:key="*this">{{index + 1}}. {{item}}</view>
      <view class="approve-overflow" wx:if="{{approveConfirm.overflow > 0}}">…另有 {{approveConfirm.overflow}} 道未显示</view>
    </scroll-view>
    <view class="approve-acts">
      <view class="approve-btn cancel" bindtap="cancelApprove">取消</view>
      <view class="approve-btn confirm" bindtap="confirmApprove">确认入库</view>
    </view>
  </view>
</view>

