  <!-- 13. 探索菜库审核（dish_lexicon_pending，2026-08-17） -->
  <view class="card" wx:if="{{tab===13}}">
    <view class="card-h">探索菜库审核（AI 现编探索菜沉淀池）</view>
    <view class="tip">探索机制 AI 现编的菜会先进入此审核池，管理员审核通过后写入 dish_lexicon 正式菜库，供后续出文复用。驳回则丢弃。</view>
    <view class="field"><text class="fl">状态</text>
      <picker mode="selector" range="{{lexiconStatusOptions}}" range-key="label" value="{{lexiconFilterIndex}}" bindchange="onLexiconFilter">
        <view class="picker">{{lexiconStatusOptions[lexiconFilterIndex].label}}</view>
      </picker>
    </view>
    <view wx:if="{{lexiconLoading}}" class="empty">加载中…</view>
    <scroll-view wx:else scroll-y class="list scroll">
      <view class="item fb" wx:for="{{lexiconList}}" wx:key="_id">
        <view class="item-main">
          <view class="item-title-row">
            <text class="item-t">{{item.name}}</text>
          </view>
          <view class="item-tags">
            <text class="tag" wx:if="{{item.cuisine}}">{{item.cuisine}}</text>
            <text class="tag cat" wx:if="{{item.category}}">{{item.category}}</text>
            <text class="tag cat" wx:if="{{item.mealTime}}">{{item.mealTime}}</text>
            <text class="tag cat" wx:if="{{item.exploreDir}}">方向:{{item.exploreDir}}</text>
