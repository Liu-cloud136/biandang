  <!-- 14. 通用配置（dynamicTabs，2026-08-18）—— 根据 dynSections schema 动态渲染，新增 A/简单B 类管理功能免发前端 -->
  <view class="card" wx:if="{{tab===14}}">
    <view class="card-h">通用配置</view>
    <view class="tip">本页由后端 adminGeneric 白名单 + 前端 dynSections schema 驱动。新增已登记功能时，在 adminGeneric ALLOWED 追加 docId/字段、在 admin.js dynSections 追加 section 即可，无需新增独立 tab。</view>

    <block wx:for="{{dynSections}}" wx:key="docId" wx:for-item="sec">
      <view class="divider" wx:if="{{index>0}}"></view>
      <view class="card-h" style="margin-top:8rpx;">{{sec.title}}</view>
      <view class="tip">{{sec.tip}}</view>

      <view class="field dyn-row" wx:if="{{dynValues[sec.docId]}}" wx:for="{{sec.fields}}" wx:key="key" wx:for-item="f">
        <!-- boolean → 开关靠右 -->
        <block wx:if="{{f.type==='boolean'}}">
          <text class="fl">{{f.label}}</text>
          <switch class="dyn-sw" checked="{{dynValues[sec.docId][f.key]}}" color="#FF8C42" data-doc-id="{{sec.docId}}" data-key="{{f.key}}" bindchange="dynSwitch" />
        </block>
        <!-- enum → 下拉 -->
        <block wx:elif="{{f.type==='enum'}}">
          <text class="fl">{{f.label}}</text>
          <picker mode="selector" range="{{f.options}}" range-key="label" value="{{dynIndex[sec.docId][f.key]}}" bindchange="dynEnumChange" data-doc-id="{{sec.docId}}" data-key="{{f.key}}">
            <view class="picker">{{f.options[dynIndex[sec.docId][f.key]].label}}</view>
          </picker>
        </block>
        <!-- string → 文本输入 -->
        <block wx:else>
          <text class="fl">{{f.label}}</text>
          <input class="fi" value="{{dynValues[sec.docId][f.key]}}" placeholder="未设置" data-doc-id="{{sec.docId}}" data-key="{{f.key}}" bindinput="dynInput" />
        </block>
      </view>

      <view class="dyn-key-box" wx:if="{{dynValues[sec.docId]}}">
        <text class="fl" style="width:auto;">密钥配置</text>
        <text class="tip sm" style="flex:1;">密钥不入库、不在此界面填写。请在 adminGeneric 云函数环境变量配置 {{sec.keyEnv}}（控制台或部署脚本），配置后实时生效，无需在此保存。</text>
      </view>

      <button class="save-btn" data-doc-id="{{sec.docId}}" bindtap="dynSaveSection">保存</button>
    </block>

    <view wx:if="{{dynLoading}}" class="empty">加载中…</view>
  </view>

  <!-- 15-18. 产物分流审核（画像/营养/做法/菜图，2026-08-21） -->
