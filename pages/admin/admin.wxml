<page-meta page-style="{{ showCatSheet ? 'overflow: hidden;' : '' }}"></page-meta>
<view class="root">
<view class="login" wx:if="{{showLogin}}">
  <view class="login-box">
    <view class="field"><text class="fl">openid</text><input class="fi" placeholder="管理员 openid" placeholder-class="ph" adjust-position="{{false}}" cursor-spacing="20" bindinput="onLoginOpenid" /></view>
    <view class="field"><text class="fl">密码</text><input class="fi" type="text" value="{{loginPwd}}" adjust-position="{{false}}" placeholder="管理员密码" placeholder-class="ph" cursor-spacing="20" bindinput="onLoginPwd" /></view>
    <view class="btn-primary" bindtap="doLogin">进入后台</view>
  </view>
</view>
<view class="page" wx:if="{{!showLogin && isAdmin}}">
  <!-- 顶部 Tab -->
  <scroll-view class="tabs" scroll-x>
    <view class="tab {{tab===idx ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="*this" wx:for-index="idx" data-tab="{{idx}}" bindtap="switchTab">{{item}}</view>
  </scroll-view>

  <!-- 0. 发次发放 -->
  <view class="card" wx:if="{{tab===0}}">
    <view class="card-h">发放免费次数</view>
    <view class="field"><text class="fl">openid</text><input class="fi" placeholder="用户 openid" value="{{grantOpenid}}" bindinput="onGrantOpenid" /></view>
    <view class="field"><text class="fl">次数</text><input class="fi" type="number" placeholder="正整数" value="{{grantCount}}" bindinput="onGrantCount" /></view>
    <view class="row-btns">
      <view class="btn-primary" bindtap="doGrant">发放</view>
      <view class="btn-ghost" bindtap="grantSelf">发给自己</view>
    </view>
  </view>

  <!-- 12. 用户管理：用户列表 + 精确查询 -->
  <view class="card" wx:if="{{tab===12}}">
    <view class="card-h">用户列表（共 {{userTotal}} 人）</view>
    <view wx:if="{{userLoading}}" class="empty">加载中…</view>
    <view wx:elif="{{userList.length === 0}}" class="empty">暂无用户</view>
    <scroll-view wx:else scroll-y class="list scroll">
      <view class="item user-item" wx:for="{{userList}}" wx:key="openid" data-no="{{item.userNo}}" data-openid="{{item.openid}}" bindtap="onUserListTap">
        <view class="item-main">
          <text class="item-t">{{item.userNo == null ? '未分配' : (item.userNo === 'admin' ? 'admin' : '#' + item.userNo)}}　{{item.openidMask}}</text>
          <text class="item-s">剩余 {{item.freeCount}}（base {{item.baseFree}} + bonus {{item.bonusFree}}）{{item.banned ? '　· 已封禁' : ''}}</text>
        </view>
        <view class="item-act">
          <view class="mini-btn {{item.banned ? 'st-valid' : 'st-block'}}">{{item.banned ? '封禁中' : '正常'}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="pager" wx:if="{{userPages > 1}}">
      <view class="pg-btn {{userPage <= 0 ? 'pg-dis' : ''}}" bindtap="onUserPagePrev">上一页</view>
      <text class="pg-text">{{userPage + 1}} / {{userPages}}</text>
      <view class="pg-btn {{userPage + 1 >= userPages ? 'pg-dis' : ''}}" bindtap="onUserPageNext">下一页</view>
    </view>

    <view class="divider"></view>
    <view class="card-h">精确查询</view>
    <view class="field"><text class="fl">openid/ID</text><input class="fi" placeholder="openid 或数字 userNo" value="{{userQueryKey}}" bindinput="onUserKey" /></view>
    <view class="btn-ghost" bindtap="doUserQuery">查询</view>
    <view class="userbox" wx:if="{{userQueryResult}}">
      <view class="urow"><text>userNo</text><text>{{userQueryResult.userNo == null ? '未分配' : userQueryResult.userNo}}</text></view>
      <view class="urow"><text>剩余次数</text><text>{{userQueryResult.freeCount}}（base {{userQueryResult.baseFree}} + bonus {{userQueryResult.bonusFree}}）</text></view>
      <view class="urow"><text>贡献数</text><text>{{userQueryResult.contribCount}}</text></view>
      <view class="urow"><text>反馈数</text><text>{{userQueryResult.feedbackCount}}</text></view>
      <view class="urow"><text>状态</text><text class="{{userQueryResult.banned ? 'ban-on' : ''}}">{{userQueryResult.banned ? '已封禁' : '正常'}}</text></view>
      <view class="urow"><text>openid</text><text class="mono">{{userQueryResult.openid}}</text></view>
      <view class="btn-warn" bindtap="toggleBan">{{userQueryResult.banned ? '解封用户' : '封禁用户'}}</view>
    </view>
  </view>

  <!-- 1. 黑名单 -->
  <view class="card" wx:if="{{tab===1}}">
    <view class="card-h">全局禁用词（黑名单）</view>
    <view class="field"><text class="fl">词</text><input class="fi" placeholder="如：怪异菜名" value="{{blockTerm}}" bindinput="onBlockTerm" /></view>
    <view class="field"><text class="fl">类型</text>
      <picker mode="selector" range="{{blockTypeOptions}}" range-key="label" value="{{blockTypeIndex}}" bindchange="onBlockType">
        <view class="picker">{{blockTypeOptions[blockTypeIndex].label}}</view>
      </picker>
    </view>
    <view class="field"><text class="fl">备注</text><input class="fi" placeholder="可选" value="{{blockNote}}" bindinput="onBlockNote" /></view>
    <view class="btn-primary" bindtap="addBlock">添加</view>

    <view class="divider"></view>
    <scroll-view scroll-y class="list scroll">
      <view class="item" wx:for="{{blocklist}}" wx:key="_id">
        <view class="item-main">
          <text class="item-t">{{item.term}}</text>
          <text class="tag">{{item.typeLabel}}</text>
          <text class="item-sub">{{item.note}}</text>
        </view>
        <view class="item-del" data-id="{{item._id}}" data-term="{{item.term}}" bindtap="removeBlock">删</view>
      </view>
      <view class="empty" wx:if="{{blocklist.length===0}}">暂无黑名单词</view>
    </scroll-view>
  </view>

  <!-- 2. 反馈审核 -->
  <view class="card" wx:if="{{tab===2}}">
    <view class="card-h">推荐反馈审核（有效 +1 次）</view>
    <view class="field"><text class="fl">状态</text>
      <picker mode="selector" range="{{feedbackStatusOptions}}" range-key="label" value="{{feedbackFilterIndex}}" bindchange="onFeedbackFilter">
        <view class="picker">{{feedbackStatusOptions[feedbackFilterIndex].label}}</view>
      </picker>
    </view>
    <scroll-view scroll-y class="list scroll">
      <view class="item fb" wx:for="{{feedbackList}}" wx:key="_id">
        <view class="item-main">
          <text class="item-t">{{item.dish}}</text>
          <text class="item-sub">用户No.{{item.userNo}} · {{item.timeText}}</text>
          <text class="item-sub" wx:if="{{item.report}}">类型：{{item.report}}</text>
          <text class="item-sub" wx:if="{{item.note}}">备注：{{item.note}}</text>
        </view>
        <view class="item-acts">
          <view class="mini ok" wx:if="{{item.status!=='valid'}}" data-id="{{item._id}}" data-decision="valid" data-source="{{item.source}}" bindtap="reviewFeedback">有效</view>
          <view class="mini no" wx:if="{{item.status!=='invalid'}}" data-id="{{item._id}}" data-decision="invalid" bindtap="reviewFeedback">无效</view>
        </view>
      </view>
      <view class="empty" wx:if="{{feedbackList.length===0}}">暂无反馈</view>
    </scroll-view>

    <view class="divider"></view>
    <view class="sub-h">用户意见反馈（我的页提交）</view>
    <scroll-view scroll-y class="list scroll">
      <view class="item fb" wx:for="{{opinionList}}" wx:key="_id">
        <view class="item-main">
          <text class="item-t">{{item.text}}</text>
          <text class="item-sub">{{item.timeText}}</text>
        </view>
        <view class="item-acts">
          <view class="mini no" data-id="{{item._id}}" bindtap="deleteOpinion">删除</view>
        </view>
      </view>
      <view class="empty" wx:if="{{opinionList.length===0}}">暂无意见反馈</view>
    </scroll-view>
  </view>

  <!-- 3. 贡献审核 -->
  <view class="card" wx:if="{{tab===3}}">
    <view class="card-h">社区贡献审核与合并</view>
    <view class="stats" wx:if="{{contribStats}}">
      <text class="stat">已通过 {{contribStats.valid}}</text><text class="stat">待审核 {{contribStats.pending}}</text><text class="stat">重复 {{contribStats.dup}}</text><text class="stat">虚假 {{contribStats.fabricated}}</text><text class="stat">已合并 {{contribStats.merged}}</text><text class="stat">已驳回 {{contribStats.blocked}}</text>
    </view>
    <view class="btn-primary" bindtap="doMerge">立即合并（强制）</view>
    <view class="field" style="margin-top:16rpx"><text class="fl">状态</text>
      <picker mode="selector" range="{{contribStatusOptions}}" range-key="label" value="{{contribFilterIndex}}" bindchange="onContribFilter">
        <view class="picker">{{contribStatusOptions[contribFilterIndex].label}}</view>
      </picker>
    </view>
    <scroll-view scroll-y class="list scroll">
      <view class="item fb" wx:for="{{contribList}}" wx:key="_id">
        <view class="item-main">
          <text class="item-t">{{item.display}}</text>
          <text class="tag">{{item.typeLabel}}</text>
          <text class="tag cat" wx:if="{{item.categoryLabel}}">{{item.categoryLabel}}</text>
          <text class="item-sub">用户No.{{item.userNo}} · {{item.timeText}}</text>
          <text class="item-sub reason" wx:if="{{item.reason}}">AI理由：{{item.reason}}</text>
        </view>
        <view class="item-acts">
          <view class="mini ok" data-id="{{item._id}}" bindtap="mergeOneContrib" wx:if="{{item.status === 'pending' || item.status === 'valid'}}">合并</view>
          <view class="mini no" data-id="{{item._id}}" bindtap="deleteContrib" wx:if="{{item.status === 'fabricated' || item.status === 'blocked' || item.status === 'merged' || item.status === 'dup'}}">删除</view>
          <view class="mini no" data-id="{{item._id}}" bindtap="rejectContrib" wx:else>驳回</view>
          <view class="mini cat" wx:if="{{item.typeLabel==='食材' && (item.status === 'pending' || item.status === 'valid' || item.status === 'merged')}}" data-id="{{item._id}}" data-cat="{{item.categoryLabel}}" bindtap="openCatEdit">改分类</view>
        </view>
      </view>
      <view class="empty" wx:if="{{contribList.length===0}}">暂无记录</view>
    </scroll-view>
  </view>

  <!-- 分类修改弹窗 -->
  <view class="sheet-mask" wx:if="{{showCatSheet}}" bindtap="closeCatSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-h">修改食材分类</view>
      <view class="sheet-tip">当前分类：{{catEditValue}}</view>
      <view class="cat-grid">
        <view class="cat-chip {{catEditValue===item?'on':''}}" wx:for="{{categoryOptions}}" wx:key="*this" data-cat="{{item}}" bindtap="onCatPick">{{item}}</view>
      </view>
      <view class="sheet-btns">
        <view class="btn-ghost" bindtap="closeCatSheet">取消</view>
        <view class="btn-primary" bindtap="confirmCatEdit">确定</view>
      </view>
    </view>
  </view>

  <!-- 4. 备份 -->
  <view class="card" wx:if="{{tab===4}}">
    <view class="card-h">数据备份（全部用户）</view>
    <view class="tip">列表含每位用户的备份与「全量备份」。恢复/删除支持跨用户；全量备份恢复将覆盖所有用户数据。</view>
    <view class="row-btns">
      <view class="btn-primary" bindtap="doBackup">备份我的数据</view>
      <view class="btn-primary" bindtap="doGlobalBackup">创建全量备份</view>
    </view>
    <scroll-view scroll-y class="list scroll">
      <view class="item" wx:for="{{backups}}" wx:key="_id">
        <view class="item-main" bindtap="restoreBackup" data-id="{{item.id}}" data-openid="{{item.openid}}" data-scope="{{item.scope}}">
          <text class="item-t">{{item.label}}</text>
          <text class="item-sub">含 {{item.count}} 条 · {{item.scope === 'global' ? '点击全量恢复' : '点击恢复'}}</text>
          <text class="item-sub owner">归属 {{item.owner}}</text>
        </view>
        <view class="item-del" data-id="{{item.id}}" data-openid="{{item.openid}}" data-scope="{{item.scope}}" bindtap="deleteBackup">删</view>
      </view>
      <view class="empty" wx:if="{{backups.length===0}}">暂无备份</view>
    </scroll-view>
  </view>

  <!-- 5. 公告 -->
  <view class="card" wx:if="{{tab===5}}">
    <view class="card-h">首页公告</view>
    <textarea class="ta" placeholder="公告内容（多条可用｜分隔）" value="{{annContent}}" bindinput="onAnnContent" maxlength="1000" />
    <view class="btn-primary" bindtap="saveAnnouncement">保存公告</view>
  </view>
  <!-- 5b. 使用说明（guide_docs） -->
  <view class="card" wx:if="{{tab===5}}">
    <view class="card-h">使用说明（首页弹层，云端下发）</view>
    <view class="tip">每行一条「标题｜正文」（标题与正文之间用全角竖线｜分隔）；标题前加 * 标记为红色高亮重要条。编号自动按顺序生成，标题里不用写。</view>
    <textarea class="ta guide-ta" placeholder="每行一条：标题｜正文&#10;示例：尝鲜｜每道菜下方「想尝试一些其他的？」可跳出偏好……" value="{{guideContent}}" bindinput="onGuideContent" maxlength="6000" />
    <view class="btn-primary" bindtap="saveGuide">保存使用说明</view>
  </view>

  <!-- 6. 账户 -->
  <view class="card" wx:if="{{tab===6}}">
    <view class="card-h">注销指定用户</view>
    <view class="field"><text class="fl">openid</text><input class="fi" placeholder="目标用户 openid" value="{{targetOpenid}}" bindinput="onTargetOpenid" /></view>
    <view class="btn-danger" bindtap="deleteTarget">注销该用户（删全部数据）</view>
    <view class="tip">管理员自身不可注销（受保护）。</view>
  </view>

  <!-- 7. 协同过滤(CF)影子模式开关（管理员，2026-08-07） -->
  <view class="card" wx:if="{{tab===7}}">
    <view class="card-h">协同过滤 · 影子模式开关</view>
    <view class="cf-row">
      <view class="cf-switch-side">
        <text class="cf-title">功能开关</text>
        <text class="cf-sub">{{cfEnabled ? '已开启' : '已关闭'}}</text>
      </view>
      <switch checked="{{cfEnabled}}" color="#07c160" disabled="{{cfLoading}}" bindchange="toggleCFSwitch" />
    </view>

    <!-- 进度：两大就绪指标 + 门槛，直观显示「距离可安全开启还差多少」 -->
    <view class="cf-progress">
      <view class="cf-bar-line">
        <text class="cf-bar-label">活跃用户</text>
        <view class="cf-bar-track"><view class="cf-bar-fill {{cfUsers >= cfThresholdUsers ? 'ok' : ''}}" style="width:{{cfUsersPct}}%"></view></view>
        <text class="cf-bar-num">{{cfUsers}} / {{cfThresholdUsers}}</text>
      </view>
      <view class="cf-bar-line">
        <text class="cf-bar-label">共现对</text>
        <view class="cf-bar-track"><view class="cf-bar-fill {{cfPairs >= cfThresholdPairs ? 'ok' : ''}}" style="width:{{cfPairsPct}}%"></view></view>
        <text class="cf-bar-num">{{cfPairs}} / {{cfThresholdPairs}}</text>
      </view>
      <view class="cf-bar-line">
        <text class="cf-bar-label">物品数</text>
        <text class="cf-bar-num2">{{cfItems}}</text>
      </view>
    </view>

    <!-- 注释：明确开启时机 -->
    <view class="cf-note">
      <text class="cf-note-h">何时开启</text>
      <text class="cf-note-p">协同过滤靠「用户间行为交叉」，小样本会过拟合乱推。待上方「活跃用户 ≥ {{cfThresholdUsers}} 且 共现对 ≥ {{cfThresholdPairs}}」两项均达标（进度条变绿、数据就绪）后，再打开本开关即可平滑启用，无需改代码重新部署。也可在未达标时强制开启（会弹确认）。</text>
      <text class="cf-note-p" wx:if="{{cfReady}}">✅ 数据已达标，{{cfCanEnable ? '建议开启。' : '开关已开启。'}}</text>
      <text class="cf-note-p" wx:elif="{{cfCanEnable}}">✅ 数据已达标，建议开启。</text>
      <text class="cf-note-p" wx:else>⏳ 数据积累中，暂不建议开启（模型由 computeCF 离线任务计算，跑出 cf_ready 后此处进度自动更新）。</text>
      <text class="cf-note-p" wx:if="{{cfComputedAtText}}">上次模型计算：{{cfComputedAtText}}</text>
    </view>
  </view>

  <!-- 8. B② Thompson 采样开关与进度（管理员，2026-08-08） -->
  <view class="card" wx:if="{{tab===8}}">
    <view class="card-h">B② · Thompson 采样开关</view>
    <view class="cf-row">
      <view class="cf-switch-side">
        <text class="cf-title">功能开关</text>
        <text class="cf-sub">{{thEnabled ? '已开启' : '已关闭'}}</text>
      </view>
      <switch checked="{{thEnabled}}" color="#07c160" disabled="{{thLoading}}" bindchange="toggleThompsonSwitch" />
    </view>

    <!-- 进度：达标臂占比 + 全局探索采纳率，直观显示「开了之后能真正用上多少」 -->
    <view class="cf-progress">
      <view class="cf-bar-line">
        <text class="cf-bar-label">达标臂</text>
        <view class="cf-bar-track"><view class="cf-bar-fill {{thArmsQualified >= thArms && thArms > 0 ? 'ok' : ''}}" style="width:{{thArmsPct}}%"></view></view>
        <text class="cf-bar-num">{{thArmsQualified}} / {{thArms}}</text>
      </view>
      <view class="cf-bar-line">
        <text class="cf-bar-label">采纳率</text>
        <view class="cf-bar-track"><view class="cf-bar-fill {{thAcceptRatePct >= 40 ? 'ok' : ''}}" style="width:{{thAcceptRatePct}}%"></view></view>
        <text class="cf-bar-num">{{thAcceptRatePct}}%</text>
      </view>
      <view class="cf-bar-line">
        <text class="cf-bar-label">推送/采纳</text>
        <text class="cf-bar-num2">{{thTotalCnt}} / {{thTotalAccept}}</text>
      </view>
    </view>

    <!-- 单臂明细：可展开列表，逐方向显示 cnt/accept/达标；达标高亮 -->
    <view class="cf-list-toggle" bindtap="toggleThList">
      <text>{{thShowList ? '收起明细 ▲' : '展开单臂明细 ▼'}}</text>
      <text class="cf-list-count">共 {{thArms}} 臂</text>
    </view>
    <view class="cf-list" wx:if="{{thShowList}}">
      <view wx:if="{{thArmsList.length === 0}}" class="cf-list-empty">暂无探索臂数据（用户尚未采纳过探索方向）</view>
      <view wx:for="{{thArmsList}}" wx:key="dir" class="cf-list-row {{item.qualified ? 'q' : ''}}">
        <text class="cf-list-dir">{{item.dir}}</text>
        <text class="cf-list-meta">推 {{item.cnt}} · 采 {{item.accept}}</text>
        <text class="cf-list-badge {{item.qualified ? 'ok' : ''}}">{{item.qualified ? '达标' : '未满'}}</text>
      </view>
    </view>

    <view class="cf-note">
      <text class="cf-note-h">门槛与说明</text>
      <text class="cf-note-p">单臂达标门槛：采纳≥ {{thMinSuccess}} 且 推送≥ {{thMinTotal}}。仅达标的探索臂在开关开启后切换为 Beta 抽样（后验期望选向），未达标臂仍走 UCB，保持冷启动均匀探索。门槛可在 sys_config/thompson_switch 调整。</text>
      <text class="cf-note-p" wx:if="{{thEnabled && thArmsQualified > 0}}">✅ 开关已开启，{{thArmsQualified}} 个臂走 Thompson 采样。</text>
      <text class="cf-note-p" wx:elif="{{thEnabled}}">⏳ 开关已开启，但尚无达标臂，实际仍全部走 UCB（等同未开，待数据积累）。</text>
      <text class="cf-note-p" wx:else>⏳ 开关关闭中。达标臂越多、采纳率越高，开启后收益越大。</text>
      <text class="cf-note-p" wx:if="{{thUpdatedAtText}}">上次开关更新：{{thUpdatedAtText}}</text>
    </view>
  </view>

  <!-- 9. 数据看板 -->
  <view class="card" wx:if="{{tab===9}}">
    <view class="card-h">数据看板</view>
    <view class="refresh-bar">
      <text class="refresh" bindtap="loadAdminStats">刷新</text>
    </view>
    <view class="tip" wx:if="{{statsLoading}}">统计计算中，请稍候…</view>
    <block wx:if="{{stats}}">
      <view class="kv"><text>统计周期</text><text class="kv-v">近 {{stats.rangeDays}} 天</text></view>
      <view class="kv"><text>总用户数</text><text class="kv-v">{{stats.totals.users}}</text></view>
      <view class="kv"><text>已封禁</text><text class="kv-v ban">{{stats.totals.banned}}</text></view>
      <view class="kv"><text>历史推荐数</text><text class="kv-v">{{stats.totals.history}}</text></view>
      <view class="kv"><text>今日推荐数</text><text class="kv-v">{{stats.today.history}}</text></view>
      <view class="kv"><text>昨日推荐数</text><text class="kv-v">{{stats.yesterday.history}}</text></view>
      <view class="kv"><text>周期内活跃用户</text><text class="kv-v">{{stats.range.activeUsers}}</text></view>
      <view class="kv"><text>周期内采纳次数</text><text class="kv-v">{{stats.range.commitCount}}</text></view>
      <view class="kv"><text>菜谱库</text><text class="kv-v">{{stats.totals.dishLibrary}}</text></view>
      <view class="kv"><text>食材库</text><text class="kv-v">{{stats.totals.ingredientLibrary}}</text></view>
      <view class="kv"><text>收藏数</text><text class="kv-v">{{stats.totals.favorites}}</text></view>
      <view class="kv"><text>待审贡献</text><text class="kv-v">{{stats.totals.contribPending}}</text></view>
      <view class="kv"><text>反馈数</text><text class="kv-v">{{stats.totals.feedback}}</text></view>
      <view class="kv"><text>菜谱指南</text><text class="kv-v">{{stats.totals.cookGuides}}</text></view>
      <view class="kv"><text>黑名单词</text><text class="kv-v">{{stats.totals.blocklist}}</text></view>
      <view class="tip" wx:if="{{stats.range.truncated}}">注：历史数据量过大，热门菜/趋势仅基于扫描的 {{stats.range.scanned}} 条，可能不完全。</view>

