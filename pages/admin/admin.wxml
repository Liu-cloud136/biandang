            <text class="tag" wx:if="{{item.source}}">{{item.source}}</text>
          </view>
          <!-- 画像详情 -->
          <view wx:if="{{tab===15 && item.profile}}">
            <text class="item-sub">菜系：{{item.profile.cuisine}} · 类型：{{item.profile.type}}</text>
            <text class="item-sub">主料：{{item.profile.main}} · 辣度：{{item.profile.spicy}}</text>
            <text class="item-sub" wx:if="{{item.profile.flavorText}}">风味：{{item.profile.flavorText}}</text>
            <text class="item-sub">素菜：{{item.profile.isVeg}} · 汤羹：{{item.profile.isSoup}}</text>
            <text class="item-sub" wx:if="{{item.profile.mealTimeText}}">餐次：{{item.profile.mealTimeText}}</text>
          </view>
          <!-- 营养详情（分区带标签） -->
          <view wx:if="{{tab===16 && item.nutrition}}">
            <view class="item-sub"><text class="tag">热量</text> {{item.nutrition[0]}}kcal　<text class="tag">蛋白</text> {{item.nutrition[1]}}g</view>
            <view class="item-sub"><text class="tag">碳水</text> {{item.nutrition[2]}}g　<text class="tag">脂肪</text> {{item.nutrition[3]}}g</view>
          </view>
          <!-- 做法详情（格式化：点评/难度 → 食材 → 步骤 → 贴士） -->
          <view wx:if="{{tab===17}}">
            <view class="item-sub" wx:if="{{item.difficulty || item.review}}">
              <text class="tag" wx:if="{{item.difficulty}}">{{item.difficulty}}</text>
              <text wx:if="{{item.review}}"> {{item.review}}</text>
            </view>
            <view class="item-sub" wx:if="{{item.ingredients.length>0}}">食材：<block wx:for="{{item.ingredients}}" wx:for-item="ing" wx:key="index">{{ing.name}} {{ing.amount}}{{ing.unit}}{{index < item.ingredients.length - 1 ? '、' : ''}}</block></view>
            <block wx:if="{{item.steps.length>0}}">
              <view class="item-sub">步骤：</view>
              <view class="item-sub" wx:for="{{item.steps}}" wx:for-item="step" wx:key="stepNo">{{step.stepNo}}. {{step.text}}</view>
            </block>
            <text class="item-sub" wx:if="{{item.tips}}">贴士：{{item.tips}}</text>
            <text class="item-sub" wx:if="{{item.guide && (!item.steps || item.steps.length===0)}}">{{item.guide}}</text>
          </view>
          <!-- 菜图预览（大图） -->
          <image wx:if="{{tab===18 && item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" style="width:300rpx;height:300rpx;border-radius:8rpx;margin:4rpx 0;" />
          <text class="item-sub" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>
        <view class="item-acts" wx:if="{{item.statusLabel==='待审核' || item.statusLabel==='已通过'}}">
          <view class="mini ok" data-id="{{item._id}}" bindtap="approvePendingReview" wx:if="{{item.statusLabel==='待审核'}}">通过</view>
          <view class="mini no" data-id="{{item._id}}" bindtap="rejectPendingReview">驳回</view>
          <view class="mini no" data-id="{{item._id}}" bindtap="deletePendingReview">删除</view>
        </view>
        <view class="item-acts" wx:elif="{{item.statusLabel==='已驳回'}}">
          <view class="mini no" data-id="{{item._id}}" bindtap="deletePendingReview">删除</view>
        </view>
      </view>
      <view class="empty" wx:if="{{pendingReviewList.length===0}}">暂无记录</view>
    </scroll-view>
  </view>

  <!-- 19. env2 菜审核（manageEnv2Regen，2026-08-24）—— 一键同步/一键入库/驳回丢弃 -->
