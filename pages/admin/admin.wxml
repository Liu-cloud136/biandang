          <view class="mini no" data-id="{{item._id}}" data-decision="invalid" bindtap="reviewNameFix">无效</view>
        </view>
        <view class="item-acts" wx:if="{{item.status==='valid'}}">
          <view class="mini no" data-id="{{item._id}}" data-decision="invalid" bindtap="reviewNameFix">无效</view>
        </view>
        <view class="item-acts">
          <view class="mini no" data-id="{{item._id}}" bindtap="deleteNameFix">删除</view>
        </view>
      </view>
      <view class="empty" wx:if="{{nameFixList.length===0}}">暂无截断修复反馈</view>
    </scroll-view>
  </view>

  <!-- tab 11 兑换码管理 -->
  <view wx:if="{{tab===11}}" class="card">
    <!-- 区域一：新建兑换码 -->
    <view class="rd-block rd-create-block">
      <view class="rd-stats" wx:if="{{redeemList.length}}">
        <view class="rd-stat"><text class="rd-stat-n">{{rdTotal}}</text><text class="rd-stat-l">总码数</text></view>
        <view class="rd-stat"><text class="rd-stat-n">{{rdActive}}</text><text class="rd-stat-l">启用中</text></view>
        <view class="rd-stat"><text class="rd-stat-n">{{rdLifeUsed}}</text><text class="rd-stat-l">累计发放(次)</text></view>
      </view>
      <view class="field"><text class="fl">每张发放次数</text><input class="fi" type="number" value="{{rdCount}}" placeholder="如 25" bindinput="onRdCount" /></view>
      <view class="field"><text class="fl">总可兑换人数</text><input class="fi" type="number" value="{{rdQuota}}" placeholder="如 100" bindinput="onRdQuota" /></view>
      <view class="field"><text class="fl">有效期(天)</text><input class="fi" type="number" value="{{rdExpire}}" placeholder="留空=长期" bindinput="onRdExpire" /></view>
      <view class="field"><text class="fl">指定码</text><input class="fi" value="{{rdCode}}" placeholder="留空=系统随机(推荐)" bindinput="onRdCode" /></view>
      <view class="field"><text class="fl">备注说明</text><input class="fi" value="{{rdDesc}}" placeholder="如 内测福利" bindinput="onRdDesc" /></view>
      <view class="btn-primary rd-create" bindtap="createRedeemCode">生成兑换码</view>
