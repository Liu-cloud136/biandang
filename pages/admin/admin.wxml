            <text class="rd-code" data-code="{{item.code}}" bindtap="copyRedeemCode">{{item.code}}</text>
          </view>
          <view class="rd-item-meta">每张 {{item.count}} 次 · 已领 {{item.used}}/{{item.quota}} 人 · {{item.expireText}}</view>
          <view class="rd-item-meta" wx:if="{{item.desc}}">说明：{{item.desc}}</view>
          <view class="rd-item-acts">
            <view class="mini {{item.active ? '' : 'dim'}}" data-code="{{item.code}}" bindtap="disableRedeemCode">{{item.active ? '停用' : '已停用'}}</view>
            <view class="mini no" data-code="{{item.code}}" bindtap="deleteRedeemCode">删除</view>
          </view>
        </view>
        <view class="empty" wx:if="{{redeemList.length===0}}">暂无兑换码</view>
      </scroll-view>
